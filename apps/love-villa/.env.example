# Love Villa: Nations — environment configuration
# EVERY key is optional: a missing key switches that provider to mock mode,
# so the whole pipeline (including rendering a real MP4) works with zero keys.

# ── Writing (Anthropic Claude) ──────────────────────────────────────────────
# Enables real character/season/episode writing. Without it, hand-authored
# fixtures + a procedural writers' room generate everything deterministically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Images (OpenAI gpt-image-1) ─────────────────────────────────────────────
# Enables real character/location art (transparent character cutouts + vertical
# backgrounds). Without it, deterministic parametric SVG art is used.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# draft = low quality (~$0.016/img) for iteration; high = medium (~$0.063/img)
IMAGE_QUALITY=draft

# ── Voices (ElevenLabs) ─────────────────────────────────────────────────────
# Enables real character voices. Map each character to a stable voice ID in
# data/voice-map.json (template: data/voice-map.example.json). Without a key,
# distinct synthesized mock voices with realistic timing are used.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Rendering ───────────────────────────────────────────────────────────────
# Chromium binary for Remotion. Auto-detected when unset (falls back to a
# Remotion-managed headless shell download).
REMOTION_BROWSER_EXECUTABLE=

# ── Cost controls ───────────────────────────────────────────────────────────
MAX_COST_PER_EPISODE_USD=5
MAX_IMAGES_PER_EPISODE=14
MAX_VIDEO_GENS_PER_EPISODE=0
MAX_TTS_REGENS_PER_LINE=2
# Reuse character/location art across episodes instead of regenerating (recommended)
REUSE_EXISTING_ASSETS=true
